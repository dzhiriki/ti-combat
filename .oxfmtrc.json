{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "sortImports": {
    "partitionByComment": true
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    ".vite",
    ".cache",
    "*.tsbuildinfo",
    "*.log",
    "npm-debug.log*",
    "pnpm-debug.log*",
    "yarn-debug.log*",
    "yarn-error.log*",
    ".env",
    ".env.local",
    ".env.*.local",
    ".vscode",
    ".idea",
    ".DS_Store"
  ]
}
